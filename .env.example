# APPLICATION
APP_NAME="Ahmed LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# URLS
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
DEPLOY_REQUIRE_HTTPS=true

# LOGGING
LOG_CHANNEL=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DATABASE
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional managed database TLS:
# MYSQL_ATTR_SSL_CA=
# DB_SSLMODE=require

# CACHE
CACHE_STORE=database
# CACHE_PREFIX=

# SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# QUEUE
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# AUTHENTICATION
SANCTUM_STATEFUL_DOMAINS=www.example.com
SANCTUM_EXPIRATION=1440

# MAIL
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# PAYMENTS
PAYMENT_PROVIDER=manual_transfer
PAYMENT_CURRENCY=EGP
MANUAL_PAYMENT_EXPIRES_MINUTES=1440
MANUAL_PAYMENT_REVIEW_ETA_HOURS=24
INSTAPAY_DESTINATION=
VODAFONE_CASH_NUMBER=
ORANGE_CASH_NUMBER=
ETISALAT_CASH_NUMBER=
# Required only when PAYMENT_PROVIDER=stripe:
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com/v1

# STORAGE AND BACKUPS
FILESYSTEM_DISK=local
BACKUP_DISK=local
MYSQLDUMP_BINARY=mysqldump

# PROXY
# Set to the exact private CIDR or IP of the reverse proxy/load balancer that reaches Laravel.
TRUSTED_PROXIES=

# ADMIN BOOTSTRAP
# Use one temporary secret-manager password for first provisioning, then rotate/remove it.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# OPTIONAL BROADCASTING
BROADCAST_CONNECTION=log

# OPTIONAL REDIS
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# OPTIONAL MEMCACHED
MEMCACHED_HOST=127.0.0.1

# OPTIONAL AWS / OBJECT STORAGE
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# GUARDIAN ONBOARDING
GUARDIAN_INVITATION_EXPIRES_HOURS=48
GUARDIAN_RESEND_COOLDOWN_MINUTES=10
GUARDIAN_MAX_DELIVERY_ATTEMPTS=5
GUARDIAN_DELIVERY_DRIVER=mail
GUARDIAN_DELIVERY_ENDPOINT=
GUARDIAN_DELIVERY_TOKEN=
GUARDIAN_DELIVERY_TIMEOUT_SECONDS=10
GUARDIAN_TEMPORARY_PASSWORD_EXPIRES_HOURS=48

# ACCOUNT DELETION GOVERNANCE
PRIVACY_DELETION_COOLING_OFF_DAYS=30
PRIVACY_FINANCIAL_RETENTION_YEARS=7
PRIVACY_POLICY_VERSION=2026-08

APP_NAME="Ahmed LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Production only: trusted load-balancer/reverse-proxy CIDRs and finite API token lifetime.
DEPLOY_REQUIRE_HTTPS=true
TRUSTED_PROXIES=
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_EXPIRATION=
PAYMENT_PROVIDER=manual_transfer
PAYMENT_CURRENCY=EGP
MANUAL_PAYMENT_EXPIRES_MINUTES=1440
MANUAL_PAYMENT_REVIEW_ETA_HOURS=24
INSTAPAY_DESTINATION=
VODAFONE_CASH_NUMBER=
ORANGE_CASH_NUMBER=
ETISALAT_CASH_NUMBER=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com/v1
ADMIN_NAME="LMS Administrator"
ADMIN_EMAIL=admin@ahmed-lms.test
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Use structured in production for JSON logs on stderr.
# LOG_CHANNEL=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahmed_lms
DB_USERNAME=
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set both values below to true and serve only over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
BACKUP_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Guardian onboarding
GUARDIAN_INVITATION_EXPIRES_HOURS=48
GUARDIAN_RESEND_COOLDOWN_MINUTES=10
GUARDIAN_MAX_DELIVERY_ATTEMPTS=5
GUARDIAN_DELIVERY_DRIVER=log
GUARDIAN_DELIVERY_ENDPOINT=
GUARDIAN_DELIVERY_TOKEN=
GUARDIAN_DELIVERY_TIMEOUT_SECONDS=10

# Account deletion governance
PRIVACY_DELETION_COOLING_OFF_DAYS=30
PRIVACY_FINANCIAL_RETENTION_YEARS=7
PRIVACY_POLICY_VERSION=2026-08
GUARDIAN_TEMPORARY_PASSWORD_EXPIRES_HOURS=48

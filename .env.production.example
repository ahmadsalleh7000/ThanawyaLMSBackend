APP_NAME="Ahmed LMS"
APP_ENV=production
APP_KEY="REQUIRES PRODUCTION VALUE"
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
DEPLOY_REQUIRE_HTTPS=true
TRUSTED_PROXIES="REQUIRES PRODUCTION VALUE"
SANCTUM_STATEFUL_DOMAINS=www.example.com
SANCTUM_EXPIRATION=10080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=structured
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahmed_lms
DB_USERNAME="REQUIRES PRODUCTION VALUE"
DB_PASSWORD="REQUIRES PRODUCTION VALUE"
MYSQL_ATTR_SSL_CA=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

FILESYSTEM_DISK=local
BACKUP_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST="REQUIRES PRODUCTION VALUE"
MAIL_PORT=587
MAIL_USERNAME="REQUIRES PRODUCTION VALUE"
MAIL_PASSWORD="REQUIRES PRODUCTION VALUE"
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_PROVIDER=manual_transfer
PAYMENT_CURRENCY=EGP
MANUAL_PAYMENT_EXPIRES_MINUTES=1440
MANUAL_PAYMENT_REVIEW_ETA_HOURS=24
INSTAPAY_DESTINATION="REQUIRES PRODUCTION VALUE"
VODAFONE_CASH_NUMBER=
ORANGE_CASH_NUMBER=
ETISALAT_CASH_NUMBER=

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_URL=https://api.stripe.com/v1

ADMIN_NAME="LMS Administrator"
ADMIN_EMAIL="REQUIRES PRODUCTION VALUE"
ADMIN_PASSWORD="REQUIRES PRODUCTION VALUE"

MYSQLDUMP_BINARY=mysqldump

GUARDIAN_INVITATION_EXPIRES_HOURS=48
GUARDIAN_RESEND_COOLDOWN_MINUTES=10
GUARDIAN_MAX_DELIVERY_ATTEMPTS=5
GUARDIAN_TEMPORARY_PASSWORD_EXPIRES_HOURS=48
GUARDIAN_DELIVERY_DRIVER=mail
GUARDIAN_DELIVERY_ENDPOINT=
GUARDIAN_DELIVERY_TOKEN=
GUARDIAN_DELIVERY_TIMEOUT_SECONDS=10

PRIVACY_DELETION_COOLING_OFF_DAYS=30
PRIVACY_FINANCIAL_RETENTION_YEARS=7
PRIVACY_POLICY_VERSION=2026-08

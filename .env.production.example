APP_NAME="Ahmed LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
DEPLOY_REQUIRE_HTTPS=true
TRUSTED_PROXIES=10.0.0.0/8
SANCTUM_STATEFUL_DOMAINS=www.example.com
SANCTUM_EXPIRATION=10080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=structured
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ahmed_lms
DB_USERNAME=ahmed_lms
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com

FILESYSTEM_DISK=local
BACKUP_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_PROVIDER=manual_transfer
PAYMENT_CURRENCY=EGP
MANUAL_PAYMENT_EXPIRES_MINUTES=1440
INSTAPAY_DESTINATION=
VODAFONE_CASH_NUMBER=
ORANGE_CASH_NUMBER=
ETISALAT_CASH_NUMBER=

ADMIN_NAME="LMS Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

MYSQLDUMP_BINARY=mysqldump
